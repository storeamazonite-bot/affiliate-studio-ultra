{
  "name": "affiliate-studio-ultra",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "desktop": "electron .",
    "dist": "electron-builder --win dir"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.affiliai.ultra",
    "productName": "AffiliAI Ultra",
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!electron-main.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AffiliAI-Ultra-${version}-Win7-x64.${ext}"
    },
    "artifactName": "AffiliAI-Ultra-${version}-Win7-x64.${ext}",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}